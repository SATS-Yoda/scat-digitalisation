# Copy to .env (gitignored). Never commit real values.

# Local development: a SQLite file filled with synthetic data by `python -m app.seed`.
DATABASE_URL=sqlite:///./dev.db
# Or the dedicated dev database on the test server (the only PostgreSQL database the seed
# and the tests will write to):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/scat_console_dev?sslmode=require

# Dify SAP-send workflow. Leave unset and Send answers 503.
# DIFY_BASE_URL=https://DIFY-HOST/v1
# DIFY_SAP_SEND_API_KEY=

# Local development only: no sign-in, act as a fixed admin. Without it the process
# refuses to start until Entra sign-in exists.
AUTH_DEV_MODE=true

# Real sign-in: set all of these and leave AUTH_DEV_MODE off. The app registration must emit
# the groups claim. Group values are Entra group object ids.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=https://<host>/auth/callback
# ENTRA_GROUP_ICC1=
# ENTRA_GROUP_ICC2=
# ENTRA_GROUP_ADMIN=
# REDIS_URL=rediss://...
